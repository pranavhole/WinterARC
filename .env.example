# PostgreSQL (Supabase). Copy both from Supabase → Connect.
# Use the pooler host (IPv4), not db.<PROJECT_REF>.supabase.co: that direct host is
# IPv6-only and Vercel can't reach it. Keep Vercel's region (vercel.json) = the database's.
#
# App queries: Transaction pooler, port 6543, with pgbouncer=true.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Migrations (prisma migrate): Session pooler, same host, port 5432.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"
# Local Docker instead (README): both URLs = postgresql://arc:arc@localhost:54329/arc?schema=public

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required when not deployed on Vercel
AUTH_TRUST_HOST=true

# ─── Phase 3 integrations (all optional; features hide themselves when unset) ──

# Encrypts OAuth tokens at rest (AES-256-GCM). 32 bytes, base64: openssl rand -base64 32
# Falls back to a key derived from AUTH_SECRET when unset.
TOKEN_ENCRYPTION_KEY=""

# LinkedIn — https://www.linkedin.com/developers/apps
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Authorized redirect URL: http://localhost:3000/api/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Google Health API — enable "Google Health API" in Google Cloud.
# Defaults to the AUTH_GOOGLE_* client. Add this redirect URI to it:
# http://localhost:3000/api/health/callback
GOOGLE_HEALTH_CLIENT_ID=""
GOOGLE_HEALTH_CLIENT_SECRET=""
# Set to "false" to hide Google Health entirely.
GOOGLE_HEALTH_ENABLED=""

# Protects GET /api/health/cron (daily health sync). Sent as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
